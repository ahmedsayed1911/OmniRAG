# ============================================================================
# OmniRAG — example configuration
#
# Copy to `.env` for local development (`.env` is git-ignored), or paste the
# equivalent values into Streamlit Cloud → App settings → Secrets.
#
# NEVER commit a real .env or real keys.
# ============================================================================

# ---------------------------------------------------------------------------
# LLM PROVIDER CHAIN  (Gemini primary → OpenRouter fallback)
#
# The app works with either provider alone; configure both to get automatic
# failover when the primary is rate-limited, out of quota, timing out, or down.
# ---------------------------------------------------------------------------
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=openrouter
ENABLE_PROVIDER_FALLBACK=true

# --- Google Gemini (primary) ---
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: use a different model for image/visual analysis.
GEMINI_VISION_MODEL=

# --- OpenRouter (fallback) ---
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# IMPORTANT: pick a vision-capable model, otherwise charts, scans and diagrams
# cannot be analysed and OmniRAG will say so rather than answer blindly.
OPENROUTER_MODEL=google/gemini-3.6-flash
# Override capability detection only if you know your model accepts images.
# OPENROUTER_MODEL_SUPPORTS_IMAGES=true

# --- Generation tuning ---
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4096
LLM_EXHAUSTIVE_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_S=90
# Quick retries per provider BEFORE failing over. Keep small so the UI stays responsive.
LLM_RETRY_ATTEMPTS=2
LLM_ENABLE_MULTIMODAL=true
MAX_IMAGES_PER_ANSWER=4

# Other supported vendors (optional; used only if named as primary/fallback):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=            # any OpenAI-compatible gateway

# ---------------------------------------------------------------------------
# EMBEDDINGS  (independent of the LLM chain — an LLM outage never invalidates
#              vectors already written to Qdrant)
#
# Leave EMBEDDING_PROVIDER empty to auto-select:
#   EMBEDDING_API_KEY / OPENAI_API_KEY -> openai
#   GEMINI_API_KEY                     -> gemini
#   nothing                            -> hash  (offline, lexical only!)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=                 # Gemini default: gemini-embedding-001
# EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=64
# 0 = provider default. Changing this requires re-indexing every document.
EMBEDDING_DIMENSIONS=0

# ---------------------------------------------------------------------------
# VECTOR DATABASE (Qdrant)
# Leave QDRANT_URL empty to use the in-memory store (index lost on restart).
# Free cloud cluster: https://cloud.qdrant.io
# ---------------------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=omnirag_chunks
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT_S=30

# ---------------------------------------------------------------------------
# RERANKING
# auto = Cohere/Jina if a key is set, else the LLM reranker, else heuristic.
# The heuristic reranker always works and needs no key.
# ---------------------------------------------------------------------------
RERANK_PROVIDER=auto
RERANK_API_KEY=
RERANK_MODEL=
RERANK_ENABLED=true

# ---------------------------------------------------------------------------
# OCR
# auto = local Tesseract if installed, else vision-model OCR (no system deps).
# ---------------------------------------------------------------------------
OCR_PROVIDER=auto
OCR_LANGUAGES=ara+eng
OCR_MIN_CONFIDENCE=0.35
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---------------------------------------------------------------------------
# VISUAL UNDERSTANDING (charts, diagrams, tables, handwriting)
# ---------------------------------------------------------------------------
VISION_ENABLED=true
MAX_IMAGES_PER_DOCUMENT=40
MIN_IMAGE_PIXELS=12100
MAX_IMAGE_EDGE=1400
PAGE_RENDER_DPI=170
DESCRIBE_PAGE_SNAPSHOTS=true

# ---------------------------------------------------------------------------
# CHUNKING
# ---------------------------------------------------------------------------
CHUNK_SIZE=1100
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=120
MAX_CHUNK_SIZE=2600

# ---------------------------------------------------------------------------
# RETRIEVAL
# ---------------------------------------------------------------------------
RETRIEVAL_STRATEGY=hybrid          # hybrid | vector | keyword
TOP_K=24                           # candidates per retriever
RERANK_TOP_K=8                     # contexts sent to the LLM
EXHAUSTIVE_SCAN_MAX_CHUNKS=120     # full scan ceiling for broad questions
EXHAUSTIVE_FINAL_K=24              # maximum broad-query contexts
USE_KEYWORD_SEARCH=true
QUERY_REWRITE=true
MAX_QUERY_EXPANSIONS=3
MAX_CONTEXT_CHARS=22000

# ---------------------------------------------------------------------------
# UPLOADS  (keep <= server.maxUploadSize in .streamlit/config.toml)
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_FILES=25
MAX_PAGES_PER_DOCUMENT=400

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
DEBUG_PANELS=false
# Safe generation lifecycle counters only; never prompts or document text.
OMNIRAG_DEBUG_GENERATION=false
SESSION_TTL_MINUTES=240
MAX_HISTORY_MESSAGES=10
# OMNIRAG_WORKSPACE=                # temp dir for page renders and crops
