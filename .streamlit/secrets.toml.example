# ============================================================================
# Streamlit secrets — EXAMPLE
#
# Local:  copy to `.streamlit/secrets.toml` and fill in your keys.
#         That file is git-ignored; this example is not.
# Cloud:  paste the same content into
#         Streamlit Cloud -> your app -> Settings -> Secrets.
#
# Both flat keys and [sections] work; flat keys are recommended.
# ============================================================================

# --- LLM provider chain: Gemini primary, OpenRouter fallback ---------------
PRIMARY_LLM_PROVIDER = "gemini"
FALLBACK_LLM_PROVIDER = "openrouter"
ENABLE_PROVIDER_FALLBACK = "true"

GEMINI_API_KEY = "your-gemini-key"
GEMINI_MODEL = "gemini-2.0-flash"

OPENROUTER_API_KEY = "your-openrouter-key"
# Must be vision-capable for chart/diagram/scan understanding.
OPENROUTER_MODEL = "google/gemini-2.0-flash-001"

# --- Embeddings ------------------------------------------------------------
# Omit to auto-select: uses your Gemini key when no dedicated key is set.
# EMBEDDING_PROVIDER = "gemini"
# EMBEDDING_API_KEY = ""
# EMBEDDING_MODEL = "gemini-embedding-001"

# --- Vector database -------------------------------------------------------
# Omit for the in-memory store (index is lost whenever the app restarts).
QDRANT_URL = "https://xxxxxxxx.eu-central.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY = "your-qdrant-key"
QDRANT_COLLECTION = "omnirag_chunks"

# --- Optional: dedicated reranker -----------------------------------------
# RERANK_PROVIDER = "cohere"
# RERANK_API_KEY = "your-cohere-key"
# RERANK_MODEL = "rerank-multilingual-v3.0"

# --- Optional tuning -------------------------------------------------------
# TOP_K = "24"
# RERANK_TOP_K = "8"
# MAX_UPLOAD_MB = "50"
# LOG_LEVEL = "INFO"

# ---------------------------------------------------------------------------
# Sectioned form is also supported, e.g.:
#
# [llm]
# api_key = "..."
# model = "gemini-2.0-flash"
#
# [qdrant]
# url = "..."
# api_key = "..."
# ---------------------------------------------------------------------------
